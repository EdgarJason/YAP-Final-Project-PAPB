{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/gateway.mjs": {
      "maxDuration": 300
    },
    "api/generate.mjs": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/build",
      "destination": "/api/gateway?yapRoute=build"
    },
    {
      "source": "/api/build/:path*",
      "destination": "/api/gateway?yapRoute=build/:path*"
    },
    {
      "source": "/api/capabilities",
      "destination": "/api/gateway?yapRoute=capabilities"
    },
    {
      "source": "/api/worker/resume",
      "destination": "/api/gateway?yapRoute=worker/resume"
    }
  ]
}
